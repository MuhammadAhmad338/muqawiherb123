{%- liquid
  assign heading = section.settings.heading | default: 'Got Questions?'
  assign heading_accent = section.settings.heading_accent

  capture default_faqs
    echo 'What is Majoon-e-Muqavi used for?|||<p>Majoon-e-Muqavi is a traditional Unani herbal formulation designed to support male vitality, physical strength, stamina, sexual wellness, and overall well-being.</p>'
    echo '~~~Does Majoon-e-Muqavi support male strength and stamina?|||<p>Majoon-e-Muqavi contains a blend of traditional herbal ingredients that have historically been valued for supporting male strength, stamina, and vitality.</p>'
    echo '~~~Can Majoon-e-Muqavi help with sexual wellness?|||<p>Yes, it is traditionally formulated to support natural sexual desire, libido, and overall male intimate wellness.</p>'
    echo '~~~Does Majoon-e-Muqavi help with bed timing?|||<p>Majoon-e-Muqavi is traditionally used to support male sexual wellness and stamina. Individual experiences may vary, and specific improvements in bed timing cannot be guaranteed.</p>'
    echo '~~~Does Majoon-e-Muqavi support energy and physical performance?|||<p>Its traditional herbal ingredients are valued for supporting everyday vitality, physical strength, and overall wellness.</p>'
    echo '~~~What ingredients are used in Majoon-e-Muqavi?|||<p>Majoon-e-Muqavi contains a blend of 45+ additional natural herbal ingredients, including Ashwagandha, Ginseng, Salab Panja, White Musli, Saffron, Shilajit, pure honey, and assorted dry fruits.</p>'
    echo '~~~How should I use Majoon-e-Muqavi?|||<p>Take ½ teaspoon at night, approximately 30 minutes after dinner. Follow the recommended dosage and do not exceed it.</p>'
    echo '~~~When is the best time to take Majoon-e-Muqavi?|||<p>The recommended time is at night, approximately 30 minutes after dinner, as mentioned in the product usage instructions.</p>'
    echo '~~~How long does Majoon-e-Muqavi take to show results?|||<p>Results may vary from person to person depending on individual factors. Consistent use according to the recommended dosage is advised. Specific results or timelines are not guaranteed.</p>'
    echo '~~~Is Majoon-e-Muqavi freshly prepared?|||<p>Yes! We prepare our orders fresh to maintain our product preparation and packaging standards. Every order is prepared with care before dispatch.</p>'
  endcapture
  assign default_faq_list = default_faqs | split: '~~~'
-%}

<div id="faq" class="muqavi-faq-{{ section.id }} section-{{ section.id }}-padding">
  <div class="muqavi-faq__inner">
    <div class="muqavi-faq__header">
      <h2 class="muqavi-faq__title">
        {{ heading | escape }}
        {%- if heading_accent != blank %} <span>{{ heading_accent | escape }}</span>{% endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="muqavi-faq__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="muqavi-faq__grid">
      <div class="muqavi-faq__list">
        {%- capture faq_icon -%}
          <span class="muqavi-faq__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <line class="muqavi-faq__icon-v" x1="12" y1="4" x2="12" y2="20"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
            </svg>
          </span>
        {%- endcapture -%}

        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <details class="muqavi-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="muqavi-faq__question">
                <span>{{ block.settings.question | escape }}</span>
                {{ faq_icon }}
              </summary>
              <div class="muqavi-faq__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        {%- else -%}
          {%- for faq in default_faq_list -%}
            {%- assign faq_parts = faq | split: '|||' -%}
            <details class="muqavi-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %}>
              <summary class="muqavi-faq__question">
                <span>{{ faq_parts[0] | strip }}</span>
                {{ faq_icon }}
              </summary>
              <div class="muqavi-faq__answer rte">{{ faq_parts[1] }}</div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="muqavi-faq__media{% if section.settings.image == blank %} muqavi-faq__media--bundled{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 460px, 100vw', alt: 'Majoon-e-Muqavi'
          }}
        {%- else -%}
          <img
            src="{{ 'majoon-e-muqavi-product.jpg' | asset_url }}"
            alt="Majoon-e-Muqavi jars and boxes"
            width="1100"
            height="1100"
            loading="lazy"
          >
        {%- endif -%}
        <div class="muqavi-faq__media-bar">
          <span class="muqavi-faq__media-tag">100% Natural &middot; Unani Formula</span>
          <span class="muqavi-faq__media-rating">
            <span class="muqavi-faq__stars" aria-hidden="true">★★★★★</span>
            200+ Reviews
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .muqavi-faq-{{ section.id }} {
    background: #ffffff;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__title {
    margin: 0 0 0.8rem;
    font-size: clamp(2.4rem, 3.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #121212;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__title span {
    color: #c6983b;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__subheading {
    margin: 0 auto;
    max-width: 560px;
    font-size: 1.4rem;
    line-height: 1.5;
    color: #6b6b6b;
  }

  .muqavi-faq-{{ section.id }} .muqavi-faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .muqavi-faq-{{ section.id }} .muqavi-faq__item {
    background: #fef1d6;
    border-radius: 10px;
    border: 1px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__item[open] {
    border-color: rgba(198, 152, 59, 0.45);
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__question {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 1.5rem 1.6rem;
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.4;
    color: #121212;
    user-select: none;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__question::-webkit-details-marker {
    display: none;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #c6983b;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__icon-v {
    transition: opacity 0.2s ease;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__item[open] .muqavi-faq__icon-v {
    opacity: 0;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__answer {
    padding: 0 1.6rem 1.6rem;
    font-size: 1.35rem;
    line-height: 1.65;
    color: #3d4a3a;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__answer p {
    margin: 0;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__answer p + p {
    margin-top: 0.8rem;
  }

  .muqavi-faq-{{ section.id }} .muqavi-faq__media {
    position: sticky;
    top: 100px;
    border-radius: 12px;
    overflow: hidden;
    background: #0f2613;
    aspect-ratio: 4 / 5;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Bundled photo has a white border baked in — zoom slightly to crop it out */
  .muqavi-faq-{{ section.id }} .muqavi-faq__media--bundled img {
    transform: scale(1.18);
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__media-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 48px 18px 16px;
    background: linear-gradient(180deg, rgba(15, 38, 19, 0) 0%, rgba(15, 38, 19, 0.92) 70%);
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__media-rating {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    white-space: nowrap;
  }
  .muqavi-faq-{{ section.id }} .muqavi-faq__stars {
    color: #fdd271;
    font-size: 1.5rem;
    letter-spacing: 1px;
  }

  @media (max-width: 849px) {
    .muqavi-faq-{{ section.id }} .muqavi-faq__grid {
      grid-template-columns: 1fr;
    }
    .muqavi-faq-{{ section.id }} .muqavi-faq__media {
      position: relative;
      top: auto;
      order: -1;
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Muqavi FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Got Questions?" },
    { "type": "text", "id": "heading_accent", "label": "Heading (gold part)", "default": "We've Got Answers" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find quick answers about Majoon-e-Muqavi, usage, and support."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the bundled Majoon-e-Muqavi photo"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open first question by default", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question & Answer",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Frequently asked question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Muqavi FAQ" }
  ]
}
{% endschema %}

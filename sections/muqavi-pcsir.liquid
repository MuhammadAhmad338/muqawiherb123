{%- style -%}
  .muqavi-pcsir-{{ section.id }} {
    padding: 56px 20px;
    text-align: center;
    background: linear-gradient(180deg, #f8fff5 0%, #fff 100%);
  }
  .muqavi-pcsir-{{ section.id }} h2 {
    margin: 0 0 12px;
    font-size: clamp(24px, 4vw, 36px);
    color: #15371b;
  }
  .muqavi-pcsir-{{ section.id }} p {
    max-width: 720px;
    margin: 0 auto;
    color: #444;
    line-height: 1.6;
  }
{%- endstyle -%}

<section class="muqavi-pcsir-{{ section.id }}">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
</section>

{% schema %}
{
  "name": "Muqavi PCSIR trust",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No Side Effects Trusted By PCSIR"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A 100% natural herbal formula designed to eliminate acidity, cool stomach heat, and restore digestive vitality from within."
    }
  ],
  "presets": [{ "name": "Muqavi PCSIR trust" }]
}
{% endschema %}

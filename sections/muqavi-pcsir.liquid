{%- liquid
  assign product = section.settings.product
  assign cta_url = product.url | default: section.settings.button_link | default: routes.all_products_collection_url
  assign cert_alt = section.settings.heading | default: 'PCSIR test report'
-%}

{%- style -%}
  .muqavi-pcsir-{{ section.id }} {
    padding: 50px 20px;
    background: #112d16;
    color: #fff;
    text-align: center;
    margin: 0 20px;
    border-radius: 12px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    padding: 6px 16px;
    background: #ffe2a0;
    color: #000;
    border-radius: 4px;
    line-height: 1.05;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-num {
    font-size: 20px;
    font-weight: 500;
    line-height: 24px;
    color: #2f723c;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy strong {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: #2f723c;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy span {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: #000;
  }
  .muqavi-pcsir-{{ section.id }} h2 {
    margin: 0 0 22px;
    max-width: 16em;
    color: #fff;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 500;
    letter-spacing: -1px;
    line-height: 1.2;
    text-transform: capitalize;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 0 0 42px;
    padding: 0;
    list-style: none;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals li {
    margin: 0;
    padding: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal {
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    color: #e4c56a;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal svg {
    width: 78px;
    height: 78px;
    display: block;
    overflow: visible;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert {
    display: block;
    width: min(264px, 72vw);
    line-height: 0;
    text-decoration: none;
    color: inherit;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.38));
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert img {
    width: 100%;
    height: auto;
    display: block;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    min-width: 240px;
    padding: 8px;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    color: #0f2613;
    border-radius: 56px;
    text-decoration: none;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta:hover {
    filter: brightness(1.04);
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1c340f;
    color: #f0c14b;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #0f2613;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark svg {
    width: 16px;
    height: 16px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-label {
    flex: 1;
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.4;
    padding-right: 4px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow svg {
    width: 24px;
    height: 24px;
  }
  @media screen and (max-width: 768px) {
    .muqavi-pcsir-{{ section.id }} {
      padding: 30px 16px;
      margin: 0 6px;
    }
    .muqavi-pcsir-{{ section.id }} h2 {
      font-size: 32px;
      max-width: 315px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal,
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal svg {
      width: 62px;
      height: 62px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
      gap: 12px;
      margin-bottom: 28px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta {
      gap: 5px;
      padding: 6px;
    }
  }
{%- endstyle -%}

<section class="muqavi-pcsir-{{ section.id }}">
  <div class="muqavi-pcsir__inner">
    <p class="muqavi-pcsir__kicker">
      <span class="muqavi-pcsir__kicker-num">#1</span>
      <span class="muqavi-pcsir__kicker-copy">
        <strong>{{ section.settings.kicker_title }}</strong>
        <span>{{ section.settings.kicker_subtitle }}</span>
      </span>
    </p>

    <h2>{{ section.settings.heading }}</h2>

    <ul class="muqavi-pcsir__seals" aria-label="Quality seals">
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="100% herbal">
          <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <circle cx="40" cy="40" r="34" stroke="#e4c56a" stroke-width="4.5"/>
            <text x="40" y="30" text-anchor="middle" fill="#e4c56a" font-size="9" font-weight="700" font-family="Arial, Helvetica, sans-serif">Herbal</text>
            <text x="40" y="46" text-anchor="middle" fill="#e4c56a" font-size="15" font-weight="800" font-family="Arial, Helvetica, sans-serif">100%</text>
            <path d="M32 56c2.2-5 6-8 8-8s5.8 3 8 8" stroke="#e4c56a" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M34 58c1.6-3.2 3.8-5 6-5s4.4 1.8 6 5" stroke="#e4c56a" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M28 54c3-7 8-10 12-8" stroke="#e4c56a" stroke-width="2.2" fill="none"/>
            <path d="M52 54c-3-7-8-10-12-8" stroke="#e4c56a" stroke-width="2.2" fill="none"/>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="100% organic">
          <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <circle cx="40" cy="46" r="26" stroke="#e4c56a" stroke-width="4.5"/>
            <path d="M40 8c-9 4-16 16-8 32 2-10 8-16 8-22 0 6 6 12 8 22 8-16 1-28-8-32z" fill="#e4c56a"/>
            <path d="M32 14c6 2 10 8 8 18" stroke="#112d16" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M48 14c-6 2-10 8-8 18" stroke="#112d16" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <text x="40" y="50" text-anchor="middle" fill="#e4c56a" font-size="15" font-weight="800" font-family="Arial, Helvetica, sans-serif">100%</text>
            <text x="40" y="64" text-anchor="middle" fill="#e4c56a" font-size="8" font-weight="700" letter-spacing="1.2" font-family="Arial, Helvetica, sans-serif">ORGANIC</text>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="Halal">
          <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <circle cx="40" cy="40" r="34" stroke="#e4c56a" stroke-width="4.5"/>
            <circle cx="40" cy="40" r="28" stroke="#e4c56a" stroke-width="1.8"/>
            <text x="40" y="38" text-anchor="middle" fill="#e4c56a" font-size="16" font-weight="700" font-family="Georgia, 'Times New Roman', serif">حلال</text>
            <text x="40" y="56" text-anchor="middle" fill="#e4c56a" font-size="11" font-weight="800" letter-spacing="1.4" font-family="Arial, Helvetica, sans-serif">HALAL</text>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="Trusted quality">
          <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <circle cx="40" cy="40" r="34" stroke="#e4c56a" stroke-width="4.5"/>
            <circle cx="40" cy="40" r="27" stroke="#e4c56a" stroke-width="2"/>
            <circle cx="40" cy="40" r="21" stroke="#e4c56a" stroke-width="1.2"/>
            <path d="M40 22l3.6 8.4 9.2.8-7 6.2 2.2 9-8-4.6-8 4.6 2.2-9-7-6.2 9.2-.8z" fill="#e4c56a"/>
          </svg>
        </span>
      </li>
    </ul>

    {%- if section.settings.certificate != blank -%}
      <a class="muqavi-pcsir__cert" href="{{ section.settings.certificate | image_url: width: 1600 }}" target="_blank" rel="noopener">
        {{
          section.settings.certificate
          | image_url: width: 900
          | image_tag: alt: cert_alt, loading: 'lazy', widths: '320, 480, 900'
        }}
      </a>
    {%- else -%}
      <a class="muqavi-pcsir__cert" href="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}" target="_blank" rel="noopener">
        <img
          src="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}"
          alt="{{ cert_alt | escape }}"
          width="1056"
          height="1356"
          loading="lazy"
        >
      </a>
    {%- endif -%}

    <a class="muqavi-pcsir__cta" href="{{ cta_url }}">
      <span class="muqavi-pcsir__cta-mark">
        {%- if product != blank and product.featured_image -%}
          {{ product.featured_image | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20c.3-6 4-10 10-11.5C20.5 15 16 19 12 20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M12 20c-.3-6-4-10-10-11.5C3.5 15 8 19 12 20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </span>
      <span class="muqavi-pcsir__cta-label">{{ section.settings.button_label }}</span>
      <span class="muqavi-pcsir__cta-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Muqavi PCSIR trust",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker_title",
      "label": "Badge title",
      "default": "Doctor Recommended"
    },
    {
      "type": "text",
      "id": "kicker_subtitle",
      "label": "Badge subtitle",
      "default": "Herbal Formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No Side Effects Trusted By PCSIR"
    },
    {
      "type": "image_picker",
      "id": "certificate",
      "label": "Certificate image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order the Majoon"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Button product"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link if no product"
    }
  ],
  "presets": [{ "name": "Muqavi PCSIR trust" }]
}
{% endschema %}

{%- liquid
  assign product = section.settings.product
  assign cta_url = product.url | default: section.settings.button_link | default: routes.all_products_collection_url
  assign cert_alt = section.settings.heading | default: 'PCSIR test report'
-%}

{%- style -%}
  .muqavi-pcsir-{{ section.id }} {
    background: #112d16;
    color: #fff;
    padding: 64px 20px 72px;
    text-align: center;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px 6px 10px;
    background: linear-gradient(180deg, #f8e7b4 0%, #e4c56a 100%);
    color: #3a2e0c;
    border-radius: 3px;
    line-height: 1.05;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-num {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy strong {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy span {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .muqavi-pcsir-{{ section.id }} h2 {
    margin: 18px 0 20px;
    max-width: 16em;
    color: #fff;
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals li {
    margin: 0;
    padding: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    color: #e8c96a;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal svg {
    width: 54px;
    height: 54px;
    display: block;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert {
    display: inline-block;
    line-height: 0;
    text-decoration: none;
    color: inherit;
    padding: 5px;
    border: 2px solid #e4c56e;
    background: #e4c56e;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert:hover {
    transform: translateY(-2px);
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert img {
    width: 240px;
    max-width: 68vw;
    height: auto;
    display: block;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    min-width: 240px;
    padding: 5px 6px 5px 5px;
    background: linear-gradient(180deg, #ffe7a6 0%, #f0c14b 48%, #d7a33a 100%);
    color: #1c340f;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta:hover {
    filter: brightness(1.04);
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #1c340f;
    color: #f0c14b;
    overflow: hidden;
    flex-shrink: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark svg {
    width: 18px;
    height: 18px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-label {
    flex: 1;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.1;
    padding-right: 4px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid #1c340f;
    flex-shrink: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow svg {
    width: 14px;
    height: 14px;
  }
  @media screen and (max-width: 749px) {
    .muqavi-pcsir-{{ section.id }} {
      padding: 48px 16px 56px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal,
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seal svg {
      width: 46px;
      height: 46px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
      gap: 10px;
    }
  }
{%- endstyle -%}

<section class="muqavi-pcsir-{{ section.id }}">
  <div class="muqavi-pcsir__inner">
    <p class="muqavi-pcsir__kicker">
      <span class="muqavi-pcsir__kicker-num">#1</span>
      <span class="muqavi-pcsir__kicker-copy">
        <strong>{{ section.settings.kicker_title }}</strong>
        <span>{{ section.settings.kicker_subtitle }}</span>
      </span>
    </p>

    <h2>{{ section.settings.heading }}</h2>

    <ul class="muqavi-pcsir__seals" aria-label="Quality seals">
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="100% natural">
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="1.6"/>
            <path d="M32 46c.4-10 6.5-16.5 16-19-1.2 10.5-7.2 17-16 19Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M32 46c-.4-10-6.5-16.5-16-19 1.2 10.5 7.2 17 16 19Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M32 46V28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="100 percent herbal">
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="1.6"/>
            <text x="32" y="37" text-anchor="middle" fill="currentColor" font-size="15" font-weight="700" font-family="Arial, Helvetica, sans-serif">100%</text>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="Chemical free">
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="1.6"/>
            <path d="M27 18h10M30 18v8L22 42a6 6 0 0 0 5.2 9h9.6A6 6 0 0 0 42 42L34 26v-8" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M24 36h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </li>
      <li>
        <span class="muqavi-pcsir__seal" role="img" aria-label="Trusted quality">
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="1.6"/>
            <path d="M32 16l4.2 2.4 4.8-.4 1.6 4.6 4.2 2.4-1.6 4.6.4 4.8-4.6 1.6L38.6 45 32 46.2 25.4 45l-2.4-4.4-4.6-1.6.4-4.8-1.6-4.6 4.2-2.4 1.6-4.6 4.8.4L32 16Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            <path d="M27.5 32.5l3 3 6.5-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </li>
    </ul>

    {%- if section.settings.certificate != blank -%}
      <a class="muqavi-pcsir__cert" href="{{ section.settings.certificate | image_url: width: 1600 }}" target="_blank" rel="noopener">
        {{
          section.settings.certificate
          | image_url: width: 800
          | image_tag: alt: cert_alt, loading: 'lazy', widths: '300, 480, 800'
        }}
      </a>
    {%- else -%}
      <a class="muqavi-pcsir__cert" href="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}" target="_blank" rel="noopener">
        <img
          src="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}"
          alt="{{ cert_alt | escape }}"
          width="413"
          height="601"
          loading="lazy"
        >
      </a>
    {%- endif -%}

    <a class="muqavi-pcsir__cta" href="{{ cta_url }}">
      <span class="muqavi-pcsir__cta-mark">
        {%- if product != blank and product.featured_image -%}
          {{ product.featured_image | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20c.3-6 4-10 10-11.5C20.5 15 16 19 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M12 20c-.3-6-4-10-10-11.5C3.5 15 8 19 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </span>
      <span class="muqavi-pcsir__cta-label">{{ section.settings.button_label }}</span>
      <span class="muqavi-pcsir__cta-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Muqavi PCSIR trust",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker_title",
      "label": "Badge title",
      "default": "Doctor Recommended"
    },
    {
      "type": "text",
      "id": "kicker_subtitle",
      "label": "Badge subtitle",
      "default": "Herbal Formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No Side Effects Trusted By PCSIR"
    },
    {
      "type": "image_picker",
      "id": "certificate",
      "label": "Certificate image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Muqavi Relief Plus"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Button product"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link if no product"
    }
  ],
  "presets": [{ "name": "Muqavi PCSIR trust" }]
}
{% endschema %}

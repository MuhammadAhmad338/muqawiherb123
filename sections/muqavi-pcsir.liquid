{%- liquid
  assign product = section.settings.product
  assign cta_url = product.url | default: section.settings.button_link | default: routes.all_products_collection_url
  assign cert_alt = section.settings.heading | default: 'PCSIR test report'
-%}

{%- style -%}
  .muqavi-pcsir-{{ section.id }} {
    padding: 50px 20px;
    background: #112d16;
    color: #fff;
    text-align: center;
    margin: 0 20px;
    border-radius: 12px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    padding: 6px 16px;
    background: #ffe2a0;
    color: #000;
    border-radius: 4px;
    line-height: 1.05;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-num {
    font-size: 20px;
    font-weight: 500;
    line-height: 24px;
    color: #2f723c;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy strong {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: #2f723c;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__kicker-copy span {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: #000;
  }
  .muqavi-pcsir-{{ section.id }} h2 {
    margin: 0 0 22px;
    max-width: 16em;
    color: #fff;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 500;
    letter-spacing: -1px;
    line-height: 1.2;
    text-transform: capitalize;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 42px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals img {
    display: block;
    height: 100px;
    width: auto;
    max-width: min(420px, 90vw);
    object-fit: contain;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert {
    display: block;
    width: min(264px, 72vw);
    line-height: 0;
    text-decoration: none;
    color: inherit;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.38));
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cert img {
    width: 100%;
    height: auto;
    display: block;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    min-width: 240px;
    padding: 8px;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    color: #0f2613;
    border-radius: 56px;
    text-decoration: none;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta:hover {
    filter: brightness(1.04);
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1c340f;
    color: #f0c14b;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #0f2613;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-mark svg {
    width: 16px;
    height: 16px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-label {
    flex: 1;
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.4;
    padding-right: 4px;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta-arrow svg {
    width: 24px;
    height: 24px;
  }
  @media screen and (max-width: 768px) {
    .muqavi-pcsir-{{ section.id }} {
      padding: 30px 16px;
      margin: 0 6px;
    }
    .muqavi-pcsir-{{ section.id }} h2 {
      font-size: 32px;
      max-width: 315px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals {
      margin-bottom: 28px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__seals img {
      height: 68px;
    }
    .muqavi-pcsir-{{ section.id }} .muqavi-pcsir__cta {
      gap: 5px;
      padding: 6px;
    }
  }
{%- endstyle -%}

<section class="muqavi-pcsir-{{ section.id }}">
  <div class="muqavi-pcsir__inner">
    <p class="muqavi-pcsir__kicker">
      <span class="muqavi-pcsir__kicker-num">#1</span>
      <span class="muqavi-pcsir__kicker-copy">
        <strong>{{ section.settings.kicker_title }}</strong>
        <span>{{ section.settings.kicker_subtitle }}</span>
      </span>
    </p>

    <h2>{{ section.settings.heading }}</h2>

    <div class="muqavi-pcsir__seals">
      <img
        src="{{ 'muqavi-trust-seals.png' | asset_url }}"
        alt="100% Herbal, 100% Organic, Halal, Pakistan Council of Scientific and Industrial Research"
        width="1588"
        height="407"
        loading="lazy"
      >
    </div>

    {%- if section.settings.certificate != blank -%}
      <a class="muqavi-pcsir__cert" href="{{ section.settings.certificate | image_url: width: 1600 }}" target="_blank" rel="noopener">
        {{
          section.settings.certificate
          | image_url: width: 900
          | image_tag: alt: cert_alt, loading: 'lazy', widths: '320, 480, 900'
        }}
      </a>
    {%- else -%}
      <a class="muqavi-pcsir__cert" href="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}" target="_blank" rel="noopener">
        <img
          src="{{ 'muqavi-pcsir-certificate.jpg' | asset_url }}"
          alt="{{ cert_alt | escape }}"
          width="1056"
          height="1356"
          loading="lazy"
        >
      </a>
    {%- endif -%}

    <a class="muqavi-pcsir__cta" href="{{ cta_url }}">
      <span class="muqavi-pcsir__cta-mark">
        {%- if product != blank and product.featured_image -%}
          {{ product.featured_image | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20c.3-6 4-10 10-11.5C20.5 15 16 19 12 20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M12 20c-.3-6-4-10-10-11.5C3.5 15 8 19 12 20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </span>
      <span class="muqavi-pcsir__cta-label">{{ section.settings.button_label }}</span>
      <span class="muqavi-pcsir__cta-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Muqavi PCSIR trust",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker_title",
      "label": "Badge title",
      "default": "Doctor Recommended"
    },
    {
      "type": "text",
      "id": "kicker_subtitle",
      "label": "Badge subtitle",
      "default": "Herbal Formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No Side Effects Trusted By PCSIR"
    },
    {
      "type": "image_picker",
      "id": "certificate",
      "label": "Certificate image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order the Majoon"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Button product"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link if no product"
    }
  ],
  "presets": [{ "name": "Muqavi PCSIR trust" }]
}
{% endschema %}

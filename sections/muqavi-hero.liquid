<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

{%- style -%}
  .muqavi-hero-{{ section.id }} { background: #fff; padding: 0; }
  .muqavi-hero-{{ section.id }} .hero-full-image { width: 100%; display: block; height: auto; object-fit: cover; }
{%- endstyle -%}

<section class="muqavi-hero-{{ section.id }} hero-section">
  <div class="swiper muqavi-hero-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'hero-full-image', loading: 'lazy' }}
          {%- else -%}
            <img class="hero-full-image" src="{{ 'muqavi-herbs-logo.jpg' | asset_url }}" alt="{{ shop.name }}" loading="lazy">
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper === 'undefined') return;
    new Swiper('.muqavi-hero-swiper-{{ section.id }}', {
      slidesPerView: 1,
      loop: true,
      autoplay: { delay: 3000, disableOnInteraction: false },
      pagination: { el: '.muqavi-hero-{{ section.id }} .swiper-pagination', clickable: true }
    });
  });
</script>

{% schema %}
{
  "name": "Muqavi hero",
  "tag": "section",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Muqavi hero", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

{%- liquid
  assign slide_count = section.blocks.size
-%}

{%- style -%}
  .muqavi-hero-{{ section.id }} {
    background: #fff;
    padding: 0;
  }
  .muqavi-hero-{{ section.id }} .hero-full-image {
    width: 100%;
    display: block;
    height: auto;
    max-height: 78vh;
    object-fit: cover;
    object-position: center;
  }
  .muqavi-hero-{{ section.id }} .swiper-pagination-bullet {
    background: #15371b;
  }
  .muqavi-hero-{{ section.id }} .swiper-pagination-bullet-active {
    background: #c6983b;
  }
{%- endstyle -%}

<section class="muqavi-hero-{{ section.id }} hero-section" aria-label="Banner">
  <div class="swiper muqavi-hero-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'hero-full-image', loading: 'eager', alt: shop.name }}
          {%- else -%}
            <img
              class="hero-full-image"
              src="{{ 'majoon-e-muqavi-product.jpg' | asset_url }}"
              alt="{{ shop.name }}"
              width="1100"
              height="1100"
              loading="eager"
            >
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if slide_count > 1 -%}
      <div class="swiper-pagination"></div>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper === 'undefined') return;
    var slideCount = {{ slide_count | default: 1 }};
    new Swiper('.muqavi-hero-swiper-{{ section.id }}', {
      slidesPerView: 1,
      loop: slideCount > 1,
      autoplay: slideCount > 1 ? { delay: 3000, disableOnInteraction: false } : false,
      pagination: slideCount > 1
        ? { el: '.muqavi-hero-{{ section.id }} .swiper-pagination', clickable: true }
        : false
    });
  });
</script>

{% schema %}
{
  "name": "Muqavi hero",
  "tag": "section",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Muqavi hero", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}

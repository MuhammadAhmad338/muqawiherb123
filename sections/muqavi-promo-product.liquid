{%- liquid
  assign product = section.settings.product
  assign title_text = 'Majoon-e-Muqavi'
  assign description_text = 'A traditional herbal tonic for vitality, stamina and strength'
  assign variant = product.selected_or_first_available_variant
  assign product_url = product.url | default: section.settings.button_link | default: routes.all_products_collection_url
  assign button_label = 'BUY MAJOON NOW'
-%}

{%- style -%}
  .section-{{ section.id }}-promo-padding {
    padding-top: 40px;
    padding-bottom: 40px;
    background-color: #15371b;
    margin: 0 20px;
    border-radius: 12px;
  }
  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-promo-padding {
      margin: 0;
      border-radius: 0;
    }
  }
  .section-{{ section.id }}-promo-padding .promo-product-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .section-{{ section.id }}-promo-padding .promo-product-image {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1;
  }
  .section-{{ section.id }}-promo-padding .promo-product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
    display: block;
  }
  .section-{{ section.id }}-promo-padding .promo-product-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .section-{{ section.id }}-promo-padding .promo-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .section-{{ section.id }}-promo-padding .promo-rating__stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .section-{{ section.id }}-promo-padding .promo-rating__text p {
    color: #fff;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
  }
  .section-{{ section.id }}-promo-padding .promo-rating__divider {
    color: #fff;
    font-size: 13px;
  }
  .section-{{ section.id }}-promo-padding .promo-product-title {
    margin: 0;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
    font-size: 32px;
    line-height: 120%;
    text-transform: capitalize;
  }
  .section-{{ section.id }}-promo-padding .promo-product-desc {
    color: #fff;
    margin: 0;
    font-size: 16px;
    line-height: 140%;
  }
  .section-{{ section.id }}-promo-padding .promo-price-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-{{ section.id }}-promo-padding .promo-price-sale {
    background-color: #2d5a27;
    color: #fff;
    padding: 5px 14px;
    border-radius: 12px;
    font-weight: 500;
    font-size: 14px;
  }
  .section-{{ section.id }}-promo-padding .promo-price-compare {
    color: #999;
    text-decoration: line-through;
    font-size: 12px;
  }
  .section-{{ section.id }}-promo-padding .promo-bullets-wrap {
    display: grid;
    padding-top: 22px;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
  }
  .section-{{ section.id }}-promo-padding .promo-bullets-col__label {
    color: #fff;
    margin-bottom: 12px;
    font-size: 14px;
    line-height: 130%;
  }
  .section-{{ section.id }}-promo-padding .promo-bullets-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .section-{{ section.id }}-promo-padding .promo-bullets-col ul li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #fff;
    font-weight: 500;
    font-size: 14px;
    line-height: 120%;
  }
  .section-{{ section.id }}-promo-padding .promo-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-width: 462px;
    padding: 16px 24px;
    color: #1a3a15;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  .section-{{ section.id }}-promo-padding .promo-cta-btn:hover {
    opacity: 0.88;
  }
  .section-{{ section.id }}-promo-padding .promo-trust-badges {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .section-{{ section.id }}-promo-padding .promo-trust-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #ccc;
  }
  .section-{{ section.id }}-promo-padding .promo-trust-badge img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-promo-padding .promo-product-wrapper {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .section-{{ section.id }}-promo-padding .promo-product-desc {
      font-size: 12px;
    }
    .section-{{ section.id }}-promo-padding .promo-bullets-col ul li {
      font-size: 12px;
    }
    .section-{{ section.id }}-promo-padding .promo-trust-badges {
      justify-content: center;
    }
    .section-{{ section.id }}-promo-padding .promo-product-content {
      gap: 10px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-promo-padding">
  <div class="page-width">
    <div class="promo-product-wrapper">
      <div class="promo-product-image">
        <img src="{{ 'majoon-e-muqavi-product.jpg' | asset_url }}" alt="{{ title_text | escape }}" loading="lazy" width="1100" height="1100">
      </div>

      <div class="promo-product-content">
        <div class="promo-rating">
          <div class="promo-rating__stars">
            {%- for i in (1..5) -%}
              {%- capture star_uid -%}{{ section.id }}-star-{{ i }}{%- endcapture -%}
              {% render 'promo-gold-star', id: star_uid %}
            {%- endfor -%}
          </div>
          <span class="promo-rating__text"><p><strong>{{ section.settings.rating_score }}</strong></p></span>
          <span class="promo-rating__divider">|</span>
          <span class="promo-rating__text"><p><strong>{{ section.settings.review_count }}</strong> reviews</p></span>
        </div>

        <h2 class="promo-product-title">{{ title_text }}</h2>
        <p class="promo-product-desc">{{ description_text }}</p>

        <div class="promo-price-wrap">
          {%- if product != blank and variant -%}
            <span class="promo-price-sale">{{ variant.price | money_without_currency }}</span>
            {%- if variant.compare_at_price > variant.price -%}
              <span class="promo-price-compare">{{ variant.compare_at_price | money_without_currency }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="promo-price-sale">{{ section.settings.fallback_price }}</span>
            <span class="promo-price-compare">{{ section.settings.fallback_compare_price }}</span>
          {%- endif -%}
        </div>

        <div class="promo-bullets-wrap">
          <div class="promo-bullets-col">
            <p class="promo-bullets-col__label">General Benefits</p>
            <ul>
              <li>{% render 'promo-check-icon' %} Supports natural energy and stamina through the day</li>
              <li>{% render 'promo-check-icon' %} Helps support healthy blood circulation</li>
              <li>{% render 'promo-check-icon' %} Supports overall strength and male vitality</li>
              <li>{% render 'promo-check-icon' %} Traditionally used as a nourishing tonic, made with salep, dry fruits and pure honey</li>
              <li>{% render 'promo-check-icon' %} Contains ashwagandha, traditionally used to support the body during everyday stress and fatigue</li>
              <li>{% render 'promo-check-icon' %} Includes saffron and ginseng, traditionally valued for well-being and vitality</li>
              <li>{% render 'promo-check-icon' %} Prepared in the traditional majoon form from carefully selected natural ingredients</li>
            </ul>
          </div>
          <div class="promo-bullets-col">
            <p class="promo-bullets-col__label">Benefits for Married Life</p>
            <ul>
              <li>{% render 'promo-check-icon' %} Helps support sexual desire (libido)</li>
              <li>{% render 'promo-check-icon' %} Supports male stamina and endurance</li>
              <li>{% render 'promo-check-icon' %} Traditionally used to support healthy blood flow for firmer, healthier erections</li>
              <li>{% render 'promo-check-icon' %} Beneficial in cases of erectile weakness, as used in traditional Unani practice</li>
              <li>{% render 'promo-check-icon' %} Supports confidence and a relaxed, balanced mind</li>
              <li>{% render 'promo-check-icon' %} Supports energy and vitality for a more active married life</li>
              <li>{% render 'promo-check-icon' %} Supports overall male wellness for a healthier, more balanced married life</li>
            </ul>
          </div>
        </div>

        {%- if product_url != blank -%}
          <a href="{{ product_url }}" class="promo-cta-btn">
            {{ button_label }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}

        <div class="promo-trust-badges">
          <div class="promo-trust-badge">
            <img src="{{ 'promo-shield.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            <span>PCSIR Tested &amp; Certified</span>
          </div>
          <div class="promo-trust-badge">
            <img src="{{ 'promo-natural.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            <span>100% Natural No Steroids</span>
          </div>
          <div class="promo-trust-badge">
            <img src="{{ 'promo-delivery.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            <span>Free Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Majoon product banner",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Product image (optional)" },
    { "type": "text", "id": "title", "label": "Title if no product", "default": "Majoon-e-Muqavi" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A traditional herbal tonic for vitality, stamina and strength"
    },
    { "type": "text", "id": "rating_score", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count label", "default": "200+" },
    { "type": "text", "id": "fallback_price", "label": "Price if no product", "default": "2,450.00" },
    { "type": "text", "id": "fallback_compare_price", "label": "Compare price if no product", "default": "3,500.00" },
    { "type": "text", "id": "general_label", "label": "Left column label", "default": "General Benefits" },
    { "type": "text", "id": "marital_label", "label": "Right column label", "default": "Benefits for Married Life" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "BUY MAJOON NOW" },
    { "type": "url", "id": "button_link", "label": "Button link if no product" }
  ],
  "blocks": [
    {
      "type": "general_benefit",
      "name": "General benefit",
      "settings": [{ "type": "text", "id": "text", "label": "Benefit", "default": "Balances excess liver heat" }]
    },
    {
      "type": "marital_benefit",
      "name": "Marital benefit",
      "settings": [{ "type": "text", "id": "text", "label": "Benefit", "default": "Relieves acidity, burning, and pain in the stomach" }]
    }
  ],
  "presets": [
    {
      "name": "Majoon product banner",
      "blocks": [
        { "type": "general_benefit", "settings": { "text": "Balances excess liver heat" } },
        { "type": "general_benefit", "settings": { "text": "Relieves burning sensation in hands and feet" } },
        { "type": "general_benefit", "settings": { "text": "Creates a cooling effect in the body" } },
        { "type": "general_benefit", "settings": { "text": "Strengthens the mind and improves eyesight" } },
        { "type": "general_benefit", "settings": { "text": "Beneficial for burning/irritation in the eyes" } },
        { "type": "general_benefit", "settings": { "text": "Helps with stomach and intestinal ulcers" } },
        { "type": "marital_benefit", "settings": { "text": "Relieves acidity, burning, and pain in the stomach" } },
        { "type": "marital_benefit", "settings": { "text": "Beneficial for nausea and vomiting" } },
        { "type": "marital_benefit", "settings": { "text": "Helps with pain and burning in bleeding hemorrhoids (piles)" } },
        { "type": "marital_benefit", "settings": { "text": "Beneficial for biliary jaundice (yellowing due to bile)" } },
        { "type": "marital_benefit", "settings": { "text": "Helpful in insomnia / sleeplessness" } },
        { "type": "marital_benefit", "settings": { "text": "Relieves palpitations, anxiety, and restlessness" } }
      ]
    }
  ]
}
{% endschema %}

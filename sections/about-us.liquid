<div id="about-us" class="muqavi-about-anchor">
  {% render 'muqavi-about-display', scope_id: section.id, section: section %}
</div>

{% schema %}
{
  "name": "About Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Row 1: Welcome to Muqavi Herbs"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Row 1 Image"
    },
    {
      "type": "text",
      "id": "welcome_heading",
      "label": "Welcome Heading",
      "default": "Welcome to Muqavi Herbs"
    },
    {
      "type": "text",
      "id": "welcome_subheading",
      "label": "Welcome Subtitle",
      "default": "Tradition Meets Natural Wellness"
    },
    {
      "type": "textarea",
      "id": "welcome_para_1",
      "label": "Paragraph 1",
      "default": "Muqavi Herbs is dedicated to bringing the wisdom of traditional Unani herbal formulations to modern lifestyles. We believe in the power of nature and carefully selected herbal ingredients to support overall wellness, vitality, and a healthier lifestyle."
    },
    {
      "type": "textarea",
      "id": "welcome_para_2",
      "label": "Paragraph 2",
      "default": "Our formulations are inspired by traditional herbal knowledge and prepared using a blend of carefully selected natural ingredients. With a commitment to quality, authenticity, and customer satisfaction, we aim to make traditional herbal wellness accessible to everyone."
    },
    {
      "type": "textarea",
      "id": "welcome_para_3",
      "label": "Paragraph 3",
      "default": "At Muqavi Herbs, our mission is simple: to promote natural wellness through thoughtfully prepared herbal formulations that bring together traditional wisdom and modern quality standards."
    },
    {
      "type": "text",
      "id": "welcome_tagline",
      "label": "Welcome Tagline",
      "default": "Discover the Tradition. Experience Natural Wellness."
    },
    {
      "type": "text",
      "id": "welcome_btn_label",
      "label": "Button Label",
      "default": "Buy Now"
    },
    {
      "type": "header",
      "content": "Row 2: Why Choose Majoon-e-Muqavi"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Row 2 Image"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why Choose Heading",
      "default": "Why Choose Majoon-e-Muqavi?"
    },
    {
      "type": "text",
      "id": "closing_line",
      "label": "Closing Line",
      "default": "Muqavi Herbs – Bringing Traditional Herbal Wellness to Modern Life."
    },
    {
      "type": "header",
      "content": "Row 3: Our Mission"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Row 3 Image"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Mission Heading",
      "default": "Our Mission"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Mission Subtitle",
      "default": "Discover the Power of Traditional Herbal Wellness"
    },
    {
      "type": "textarea",
      "id": "intro_para_1",
      "label": "Mission Paragraph 1",
      "default": "Our mission is to bring the benefits of traditional Unani herbal formulations to modern lifestyles through carefully selected ingredients, quality-focused preparations, and affordable wellness solutions."
    },
    {
      "type": "textarea",
      "id": "intro_para_2",
      "label": "Mission Paragraph 2",
      "default": "At Muqavi Herbs, we believe in combining traditional herbal wisdom with a commitment to quality and customer satisfaction. We aim to make natural wellness a part of everyday life while supporting strength, vitality, and overall well-being."
    },
    {
      "type": "text",
      "id": "cta_lead",
      "label": "Journey Line",
      "default": "Start Your Journey Towards Natural Wellness Today."
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Explore Line",
      "default": "Explore Majoon-e-Muqavi and discover a formulation inspired by traditional herbal knowledge."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Mission Button Label",
      "default": "Explore Majoon-e-Muqavi"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title (with colon)" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "title": "Traditional Unani Formulation:",
            "text": "Inspired by traditional Unani wisdom and formulated with carefully selected herbal ingredients."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "45+ Natural Herbal Ingredients:",
            "text": "Enriched with a blend of traditional herbs, dry fruits, pure honey and other carefully selected ingredients."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Male Vitality & Wellness:",
            "text": "Traditionally formulated to support male vitality, stamina, strength and overall intimate wellness."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Carefully Selected Ingredients:",
            "text": "Contains traditional ingredients such as Ashwagandha, Ginseng, Salab Panja, Saffron and Shilajit."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Commitment to Quality:",
            "text": "We focus on ingredient selection, product quality and customer satisfaction in every formulation."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Dedicated Customer Support:",
            "text": "Our team is available to assist you with product information, usage guidance and order-related queries across Pakistan."
          }
        }
      ],
      "settings": {
        "welcome_heading": "Welcome to Muqavi Herbs",
        "welcome_subheading": "Tradition Meets Natural Wellness",
        "why_heading": "Why Choose Majoon-e-Muqavi?",
        "closing_line": "Muqavi Herbs – Bringing Traditional Herbal Wellness to Modern Life.",
        "mission_heading": "Our Mission",
        "intro_heading": "Discover the Power of Traditional Herbal Wellness",
        "welcome_btn_label": "Buy Now",
        "button_label": "Explore Majoon-e-Muqavi"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

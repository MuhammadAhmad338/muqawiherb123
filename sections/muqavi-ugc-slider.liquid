{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign slide_count = 0
  assign ugc_slide_width = section.settings.slide_width | default: 220 | plus: 0
  if ugc_slide_width < 160
    assign ugc_slide_width = 160
  endif
  if ugc_slide_width > 320
    assign ugc_slide_width = 320
  endif

  for block in section.blocks
    assign video_asset_chk = block.settings.video_asset | strip
    assign video_url_chk = block.settings.video_url | strip
    assign slide_has_video = false
    if video_url_chk != blank
      assign slide_has_video = true
    elsif video_asset_chk != blank
      assign slide_has_video = true
    elsif forloop.first and section.settings.default_video_asset != blank
      assign slide_has_video = true
    endif
    if slide_has_video or block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  if slide_count == 0 and section.settings.default_video_asset != blank
    assign slide_count = 1
  endif
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

{%- style -%}
  .section-{{ section.id }}-ugc-padding {
    padding-top: 50px;
    padding-bottom: 50px;
    background-color: #fff;
  }
  .section-{{ section.id }}-ugc-padding .ugc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .section-{{ section.id }}-ugc-padding .ugc-heading {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 800;
    margin: 0;
    line-height: 1.25;
  }
  .section-{{ section.id }}-ugc-padding .ugc-heading .bold { color: #1a1a1a; }
  .section-{{ section.id }}-ugc-padding .ugc-heading .light { font-weight: 400; color: #9c9c9c; }
  .section-{{ section.id }}-ugc-padding .ugc-nav button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ccc;
    background: #fff;
    cursor: pointer;
  }
  .section-{{ section.id }}-ugc-padding .ugc-header--single .ugc-nav {
    display: none;
  }
  .section-{{ section.id }}-ugc-padding .ugc-swiper-{{ section.id }} {
    margin: 0;
    width: 100%;
    overflow: hidden;
  }
  .section-{{ section.id }}-ugc-padding .ugc-swiper-{{ section.id }} .swiper-wrapper {
    align-items: stretch;
  }
  .section-{{ section.id }}-ugc-padding .ugc-slide {
    width: {{ ugc_slide_width }}px;
    max-width: min({{ ugc_slide_width }}px, 78vw);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    height: auto;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .section-{{ section.id }}-ugc-padding .ugc-media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #111;
    overflow: hidden;
  }
  .section-{{ section.id }}-ugc-padding .ugc-media img,
  .section-{{ section.id }}-ugc-padding .ugc-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }}-ugc-padding .ugc-video {
    background: #000;
  }
  .section-{{ section.id }}-ugc-padding .ugc-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    z-index: 2;
    transition: opacity 0.2s ease;
  }
  .section-{{ section.id }}-ugc-padding .ugc-play.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .section-{{ section.id }}-ugc-padding .ugc-product-block {
    position: absolute;
    bottom: 8px;
    left: 12px;
    right: 12px;
    z-index: 3;
    border-radius: 10px;
    background: rgba(250, 246, 230, 0.92);
    padding: 6px;
    pointer-events: auto;
  }
  .section-{{ section.id }}-ugc-padding .ugc-product {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .section-{{ section.id }}-ugc-padding .ugc-product-thumb {
    width: 56px;
    height: 56px;
    object-fit: contain;
    border-radius: 6px;
    background: #fafafa;
    flex-shrink: 0;
  }
  .section-{{ section.id }}-ugc-padding .ugc-product-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-{{ section.id }}-ugc-padding .ugc-product-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .section-{{ section.id }}-ugc-padding .ugc-price-current {
    font-size: 16px;
    font-weight: 800;
  }
  .section-{{ section.id }}-ugc-padding .ugc-price-compare {
    font-size: 12px;
    text-decoration: line-through;
    color: #666;
  }
  .section-{{ section.id }}-ugc-padding .ugc-buy-btn {
    margin-left: auto;
    padding: 8px 14px;
    border-radius: 8px;
    border: none;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    color: #1a3a15;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-{{ section.id }}-ugc-padding .ugc-swiper--single .swiper-wrapper {
    justify-content: flex-start;
  }
{%- endstyle -%}

{%- capture ugc_slides -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign video_asset = block.settings.video_asset | strip
      assign video_url = block.settings.video_url | strip
      assign has_video = false
      if video_url != blank
        assign has_video = true
      elsif video_asset != blank
        assign has_video = true
      elsif forloop.first and section.settings.default_video_asset != blank
        assign video_asset = section.settings.default_video_asset
        assign has_video = true
      endif
      assign has_image = false
      if block.settings.image != blank
        assign has_image = true
      endif
    -%}
    {%- if has_video or has_image -%}
      <div class="swiper-slide ugc-slide" {{ block.shopify_attributes }} data-ugc-slide>
        <div class="ugc-media">
          {%- if has_video -%}
            {%- liquid
              assign video_src = video_url
              if video_src == blank and video_asset != blank
                assign video_src = video_asset | asset_url
              endif
            -%}
            <video
              class="ugc-video"
              playsinline
              webkit-playsinline
              preload="metadata"
              {% if block.settings.poster != blank %}
                poster="{{ block.settings.poster | image_url: width: 800 }}"
              {% endif %}
            >
              <source src="{{ video_src }}" type="video/mp4">
            </video>
            <button type="button" class="ugc-play" aria-label="Play video" data-ugc-play>▶</button>
          {%- else -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 280px, 45vw', widths: '400, 600, 800'
            }}
          {%- endif -%}
          {%- if product != blank and section.settings.show_product_card -%}
            <div class="ugc-product-block">
              <div class="ugc-product">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 120 | image_tag: class: 'ugc-product-thumb', loading: 'lazy' }}
                {%- endif -%}
                <div class="ugc-product-body">
                  <p class="ugc-product-title">{{ product.title }}</p>
                  <div class="ugc-product-row">
                    {%- if variant -%}
                      <span class="ugc-price-current">{{ variant.price | money }}</span>
                      {%- if variant.compare_at_price > variant.price -%}
                        <span class="ugc-price-compare">{{ variant.compare_at_price | money }}</span>
                      {%- endif -%}
                    {%- endif -%}
                    <a class="ugc-buy-btn" href="{{ product.url }}">Buy Now</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="section-{{ section.id }}-ugc-padding">
  <div class="page-width">
    <div class="ugc-header{% if slide_count <= 1 %} ugc-header--single{% endif %}">
      <h2 class="ugc-heading">
        <span class="bold">{{ section.settings.heading_bold }}</span>
        <span class="light">{{ section.settings.heading_light }}</span>
      </h2>
      <div class="ugc-nav">
        <button type="button" class="ugc-prev-{{ section.id }}" aria-label="Previous slide">‹</button>
        <button type="button" class="ugc-next-{{ section.id }}" aria-label="Next slide">›</button>
      </div>
    </div>

    <div class="swiper ugc-swiper-{{ section.id }}{% if slide_count <= 1 %} ugc-swiper--single{% endif %}">
      <div class="swiper-wrapper">
        {%- if slide_count > 0 -%}
          {{ ugc_slides }}
        {%- elsif section.settings.default_video_asset != blank -%}
          <div class="swiper-slide ugc-slide">
            <div class="ugc-media">
              <video class="ugc-video" playsinline webkit-playsinline preload="metadata">
                <source src="{{ section.settings.default_video_asset | asset_url }}" type="video/mp4">
              </video>
              <button type="button" class="ugc-play" aria-label="Play video" data-ugc-play>▶</button>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const root = document.querySelector('.ugc-swiper-{{ section.id }}');
    if (!root) return;

    root.querySelectorAll('[data-ugc-play]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const video = btn.closest('.ugc-media')?.querySelector('.ugc-video');
        if (!video) return;
        video.controls = true;
        video.muted = false;
        const playPromise = video.play();
        if (playPromise && playPromise.then) {
          playPromise.then(() => btn.classList.add('is-hidden')).catch(() => {});
        } else {
          btn.classList.add('is-hidden');
        }
      });
    });

    root.querySelectorAll('.ugc-video').forEach((video) => {
      video.addEventListener('pause', () => {
        const btn = video.closest('.ugc-media')?.querySelector('[data-ugc-play]');
        if (btn && video.currentTime < 0.1) btn.classList.remove('is-hidden');
      });
      video.addEventListener('ended', () => {
        const btn = video.closest('.ugc-media')?.querySelector('[data-ugc-play]');
        if (btn) btn.classList.remove('is-hidden');
      });
    });

    if (typeof Swiper === 'undefined') return;
    const slideTotal = root.querySelectorAll('.swiper-slide').length;
    new Swiper(root, {
      slidesPerView: 'auto',
      spaceBetween: 14,
      centeredSlides: false,
      grabCursor: slideTotal > 1,
      navigation: {
        nextEl: '.ugc-next-{{ section.id }}',
        prevEl: '.ugc-prev-{{ section.id }}'
      }
    });
  });
</script>

{% schema %}
{
  "name": "Herbliv UGC stories",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (optional buy card)" },
    {
      "type": "checkbox",
      "id": "show_product_card",
      "label": "Show product buy card on slides",
      "default": false
    },
    {
      "type": "text",
      "id": "default_video_asset",
      "label": "Default theme video filename",
      "info": "e.g. muqavi-customer-ugc.mp4 (used when block has no media)",
      "default": "muqavi-customer-ugc.mp4"
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "Story card width",
      "min": 180,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    { "type": "text", "id": "heading_bold", "label": "Heading (bold)", "default": "See what people" },
    { "type": "text", "id": "heading_light", "label": "Heading (light)", "default": "say about us." }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
        { "type": "image_picker", "id": "poster", "label": "Video poster image" },
        {
          "type": "text",
          "id": "video_asset",
          "label": "Theme video filename",
          "info": "MP4 in theme assets folder"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Shopify Files or CDN URL if file is too large for theme assets"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Herbliv UGC stories",
      "blocks": [{ "type": "story", "settings": { "video_asset": "muqavi-customer-ugc.mp4" } }]
    }
  ]
}
{% endschema %}
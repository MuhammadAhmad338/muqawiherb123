{%- style -%}
  .muqavi-ugc-{{ section.id }} { padding: 36px 0; background: #fff; }
  .muqavi-ugc-{{ section.id }} h2 { text-align: center; margin: 0 0 24px; font-size: clamp(22px, 4vw, 32px); }
  .muqavi-ugc-{{ section.id }} .ugc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .muqavi-ugc-{{ section.id }} .ugc-card {
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 9/16;
  }
  .muqavi-ugc-{{ section.id }} .ugc-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
{%- endstyle -%}

<section class="muqavi-ugc-{{ section.id }}">
  <h2>{{ section.settings.heading | default: 'See what people say about us.' }}</h2>
  <div class="ugc-grid">
    {%- for block in section.blocks -%}
      <div class="ugc-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Muqavi UGC slider",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See what people say about us." }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [{ "name": "Muqavi UGC slider", "blocks": [{ "type": "story" }, { "type": "story" }, { "type": "story" }] }]
}
{% endschema %}

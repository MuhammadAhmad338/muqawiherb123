{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign product_url = product.url | default: section.settings.button_link | default: routes.all_products_collection_url
-%}

{%- style -%}
  .majoon-promo-{{ section.id }} {
    background: #15371b;
    margin: 0 20px 40px;
    border-radius: 12px;
    padding: 40px 0;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__photo {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
    display: block;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #fff;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__stars {
    display: flex;
    gap: 2px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__title {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    color: #fff;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__price {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__price-now {
    background: #2d5a27;
    color: #fff;
    padding: 5px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__price-was {
    color: #999;
    text-decoration: line-through;
    font-size: 12px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 20px;
    padding-top: 8px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__col-title {
    margin: 0 0 10px;
    font-size: 14px;
    color: #fff;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__cols li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 120%;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__cols li svg {
    display: block;
    width: 22px;
    height: 22px;
    min-width: 22px;
    flex: 0 0 22px;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 462px;
    width: 100%;
    padding: 16px 24px;
    border-radius: 50px;
    background: linear-gradient(180deg, #ffe2a0 0%, #fdd271 50%, #c6983b 100%);
    color: #1a3a15;
    text-decoration: none;
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
    color: #ccc;
  }
  .majoon-promo-{{ section.id }} .majoon-promo__trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media screen and (max-width: 768px) {
    .majoon-promo-{{ section.id }} {
      margin: 0 0 24px;
      border-radius: 0;
      padding: 28px 0;
    }
    .majoon-promo-{{ section.id }} .majoon-promo__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .majoon-promo-{{ section.id }} .majoon-promo__title {
      font-size: 26px;
    }
    .majoon-promo-{{ section.id }} .majoon-promo__desc,
    .majoon-promo-{{ section.id }} .majoon-promo__cols li {
      font-size: 12px;
    }
  }
{%- endstyle -%}

<section class="majoon-promo-{{ section.id }}">
  <div class="page-width">
    <div class="majoon-promo__grid">
      <div class="majoon-promo__photo">
        <img
          src="{{ 'majoon-e-muqavi-product.jpg' | asset_url }}"
          alt="Majoon-e-Muqavi"
          width="1100"
          height="1100"
          loading="lazy"
        >
      </div>

      <div class="majoon-promo__copy">
        <div class="majoon-promo__rating">
          <div class="majoon-promo__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- capture star_id -%}{{ section.id }}-{{ i }}{%- endcapture -%}
              {% render 'promo-gold-star', id: star_id %}
            {%- endfor -%}
          </div>
          <strong>4.9</strong>
          <span>|</span>
          <span><strong>200+</strong> reviews</span>
        </div>

        <h2 class="majoon-promo__title">Majoon-e-Muqavi</h2>
        <p class="majoon-promo__desc">A traditional herbal tonic for vitality, stamina and strength</p>

        <div class="majoon-promo__price">
          {%- if product != blank and variant -%}
            <span class="majoon-promo__price-now">{{ variant.price | money_without_currency }}</span>
            {%- if variant.compare_at_price > variant.price -%}
              <span class="majoon-promo__price-was">{{ variant.compare_at_price | money_without_currency }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="majoon-promo__price-now">2,450.00</span>
            <span class="majoon-promo__price-was">3,500.00</span>
          {%- endif -%}
        </div>

        <div class="majoon-promo__cols">
          <div>
            <p class="majoon-promo__col-title">General Benefits</p>
            <ul>
              <li>{% render 'promo-check-icon' %} Supports natural energy and stamina through the day</li>
              <li>{% render 'promo-check-icon' %} Helps support healthy blood circulation</li>
              <li>{% render 'promo-check-icon' %} Supports overall strength and male vitality</li>
              <li>{% render 'promo-check-icon' %} Traditionally used as a nourishing tonic, made with salep, dry fruits and pure honey</li>
              <li>{% render 'promo-check-icon' %} Contains ashwagandha, traditionally used to support the body during everyday stress and fatigue</li>
              <li>{% render 'promo-check-icon' %} Includes saffron and ginseng, traditionally valued for well-being and vitality</li>
              <li>{% render 'promo-check-icon' %} Prepared in the traditional majoon form from carefully selected natural ingredients</li>
            </ul>
          </div>
          <div>
            <p class="majoon-promo__col-title">Benefits for Married Life</p>
            <ul>
              <li>{% render 'promo-check-icon' %} Helps support sexual desire (libido)</li>
              <li>{% render 'promo-check-icon' %} Supports male stamina and endurance</li>
              <li>{% render 'promo-check-icon' %} Traditionally used to support healthy blood flow for firmer, healthier erections</li>
              <li>{% render 'promo-check-icon' %} Beneficial in cases of erectile weakness, as used in traditional Unani practice</li>
              <li>{% render 'promo-check-icon' %} Supports confidence and a relaxed, balanced mind</li>
              <li>{% render 'promo-check-icon' %} Supports energy and vitality for a more active married life</li>
              <li>{% render 'promo-check-icon' %} Supports overall male wellness for a healthier, more balanced married life</li>
            </ul>
          </div>
        </div>

        <a class="majoon-promo__btn" href="{{ product_url }}">
          BUY MAJOON NOW
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M19 12l-7-7M19 12l-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="majoon-promo__trust">
          <span>
            <img src="{{ 'promo-shield.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            PCSIR Tested &amp; Certified
          </span>
          <span>
            <img src="{{ 'promo-natural.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            100% Natural No Steroids
          </span>
          <span>
            <img src="{{ 'promo-delivery.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            Free Delivery
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Majoon product banner",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product for price and button" },
    { "type": "url", "id": "button_link", "label": "Button link if no product" }
  ],
  "presets": [{ "name": "Majoon product banner" }]
}
{% endschema %}

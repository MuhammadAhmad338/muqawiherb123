<div id="about-us" class="muqavi-about-anchor">
  {% render 'muqavi-about-display', scope_id: section.id, section: section %}
</div>

{% schema %}
{
  "name": "About Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title (H1)",
      "default": "About Us"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page title (H1)",
      "default": true
    },
    {
      "type": "header",
      "content": "About intro"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Mission section heading",
      "default": "Our Mission"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro tagline",
      "default": "Discover the Power of Traditional Herbal Wellness"
    },
    {
      "type": "textarea",
      "id": "intro_para_1",
      "label": "Intro paragraph 1",
      "default": "Our mission is to bring the benefits of traditional Unani herbal formulations to modern lifestyles through carefully selected ingredients, quality-focused preparations, and affordable wellness solutions."
    },
    {
      "type": "textarea",
      "id": "intro_para_2",
      "label": "Intro paragraph 2",
      "default": "At Muqavi Herbs, we believe in combining traditional herbal wisdom with a commitment to quality and customer satisfaction. We aim to make natural wellness a part of everyday life while supporting strength, vitality, and overall well-being."
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why choose heading",
      "default": "Why Choose Majoon-e-Muqavi?"
    },
    {
      "type": "text",
      "id": "closing_line",
      "label": "Line after why choose list",
      "default": "Muqavi Herbs – Bringing Traditional Herbal Wellness to Modern Life."
    },
    {
      "type": "text",
      "id": "cta_lead",
      "label": "Journey line (italic)",
      "default": "Start Your Journey Towards Natural Wellness Today."
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Explore line",
      "default": "Explore Majoon-e-Muqavi and discover a formulation inspired by traditional herbal knowledge."
    },
    {
      "type": "checkbox",
      "id": "show_product_button",
      "label": "Show product button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Majoon-e-Muqavi"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product link"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact section",
      "default": false
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone display",
      "default": "+92 339 0091552"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@muqaviherbsofficial.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Pakistan"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title (with colon)" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "title": "Traditional Unani Formulation:",
            "text": "Inspired by traditional Unani wisdom and formulated with carefully selected herbal ingredients."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "45+ Natural Herbal Ingredients:",
            "text": "Enriched with a blend of traditional herbs, dry fruits, pure honey and other carefully selected ingredients."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Male Vitality & Wellness:",
            "text": "Traditionally formulated to support male vitality, stamina, strength and overall intimate wellness."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Carefully Selected Ingredients:",
            "text": "Contains traditional ingredients such as Ashwagandha, Ginseng, Salab Panja, Saffron and Shilajit."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Commitment to Quality:",
            "text": "We focus on ingredient selection, product quality and customer satisfaction in every formulation."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Dedicated Customer Support:",
            "text": "Our team is available to assist you with product information, usage guidance and order-related queries across Pakistan."
          }
        }
      ],
      "settings": {
        "page_title": "About Us",
        "mission_heading": "Our Mission",
        "intro_heading": "Discover the Power of Traditional Herbal Wellness",
        "intro_para_1": "Our mission is to bring the benefits of traditional Unani herbal formulations to modern lifestyles through carefully selected ingredients, quality-focused preparations, and affordable wellness solutions.",
        "intro_para_2": "At Muqavi Herbs, we believe in combining traditional herbal wisdom with a commitment to quality and customer satisfaction. We aim to make natural wellness a part of everyday life while supporting strength, vitality, and overall well-being.",
        "cta_lead": "Start Your Journey Towards Natural Wellness Today.",
        "cta_text": "Explore Majoon-e-Muqavi and discover a formulation inspired by traditional herbal knowledge.",
        "why_heading": "Why Choose Majoon-e-Muqavi?",
        "closing_line": "Muqavi Herbs – Bringing Traditional Herbal Wellness to Modern Life.",
        "show_product_button": true,
        "button_label": "Explore Majoon-e-Muqavi"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
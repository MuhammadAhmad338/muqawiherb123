{%- style -%}
  .muqavi-struggles-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__kicker {
    display: inline-block;
    margin: 0 0 14px;
    padding: 6px 16px;
    background: #ffe2a0;
    color: #2f723c;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .muqavi-struggles-{{ section.id }} h2 {
    margin: 0 auto 28px;
    max-width: 22em;
    color: #112d16;
    font-size: clamp(24px, 3.4vw, 38px);
    font-weight: 500;
    letter-spacing: -0.5px;
    line-height: 1.25;
  }
  .muqavi-struggles-{{ section.id }} h2 span {
    color: #2f723c;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__card {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    line-height: 0;
    background: #112d16;
    box-shadow: 0 10px 24px rgba(17, 45, 22, 0.14);
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 896;
    object-fit: cover;
  }
  @media screen and (max-width: 768px) {
    .muqavi-struggles-{{ section.id }} {
      padding-left: 16px;
      padding-right: 16px;
    }
    .muqavi-struggles-{{ section.id }} .muqavi-struggles__kicker {
      font-size: 10px;
    }
    .muqavi-struggles-{{ section.id }} h2 {
      font-size: 24px;
      margin-bottom: 20px;
    }
    .muqavi-struggles-{{ section.id }} .muqavi-struggles__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
{%- endstyle -%}

<section class="muqavi-struggles-{{ section.id }}">
  <div class="muqavi-struggles__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="muqavi-struggles__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2>
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{%- endif -%}
      </h2>
    {%- endif -%}

    <div class="muqavi-struggles__grid">
      {%- for block in section.blocks -%}
        <figure class="muqavi-struggles__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag: alt: block.settings.alt, loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(max-width: 768px) 100vw, 550px'
            }}
          {%- elsif block.settings.image_asset != blank -%}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.alt | escape }}"
              width="1200"
              height="896"
              loading="lazy"
            >
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Muqavi struggles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Badge text",
      "default": "Every man has felt this, but rarely says it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You're Not Alone!"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "8 Out of 10 Men Face Challenges Related to Stamina & Intimate Wellness"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename (used if no image picked)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [{ "name": "Muqavi struggles" }],
  "enabled_on": {
    "templates": ["index", "product"]
  }
}
{% endschema %}

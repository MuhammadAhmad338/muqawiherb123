{%- style -%}
  .muqavi-struggles-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__inner {
    max-width: 1300px;
    margin: 0 auto;
  }
  .muqavi-struggles-{{ section.id }} h2 {
    margin: 0 auto 28px;
    color: #1d4a24;
    font-size: clamp(22px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__card {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    line-height: 0;
    background: #112d16;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 896;
    object-fit: cover;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__text {
    margin: 32px auto 0;
    max-width: 52em;
    color: #000;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 700;
    letter-spacing: 0.3px;
    line-height: 1.5;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__btn {
    display: inline-block;
    margin-top: 24px;
    padding: 14px 24px;
    background: #f4f3ea;
    color: #1d4a24;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .muqavi-struggles-{{ section.id }} .muqavi-struggles__btn:hover {
    background: #e9e7d6;
  }
  @media screen and (max-width: 989px) {
    .muqavi-struggles-{{ section.id }} .muqavi-struggles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }
  @media screen and (max-width: 768px) {
    .muqavi-struggles-{{ section.id }} h2 {
      margin-bottom: 20px;
    }
    .muqavi-struggles-{{ section.id }} .muqavi-struggles__text {
      margin-top: 22px;
    }
    .muqavi-struggles-{{ section.id }} .muqavi-struggles__btn {
      font-size: 14px;
      padding: 12px 18px;
    }
  }
{%- endstyle -%}

<section class="muqavi-struggles-{{ section.id }}">
  <div class="muqavi-struggles__inner">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="muqavi-struggles__grid">
      {%- for block in section.blocks -%}
        <figure class="muqavi-struggles__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag: alt: block.settings.alt, loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(max-width: 989px) 50vw, 320px'
            }}
          {%- elsif block.settings.image_asset != blank -%}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.alt | escape }}"
              width="1200"
              height="896"
              loading="lazy"
            >
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.text != blank -%}
      <p class="muqavi-struggles__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="muqavi-struggles__btn" href="{{ section.settings.button_link | default: '#MainContent' }}">
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Muqavi struggles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every man has felt this, but rarely says it"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text below images",
      "default": "You're Not Alone! 8 Out of 10 Men Face Challenges Related to Stamina & Intimate Wellness"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "That's where Majoon-e-Muqavi can help"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (defaults to top of product)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename (used if no image picked)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [{ "name": "Muqavi struggles" }],
  "enabled_on": {
    "templates": ["index", "product"]
  }
}
{% endschema %}

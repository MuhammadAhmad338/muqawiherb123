<section class="muqavi-testimonials-section">
  {% render 'muqavi-customer-reviews',
    scope_id: section.id,
    heading: section.settings.heading,
    blocks: section.blocks
  %}
</section>

{% schema %}
{
  "name": "Muqavi testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image filename (if no photo selected)",
          "info": "e.g. customer-review-1.jpg"
        },
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        {
          "type": "range",
          "id": "filled_stars",
          "label": "Star rating (1–5)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Muqavi testimonials",
      "settings": {
        "heading": "What Our Customers Say"
      },
      "blocks": [
        {
          "type": "review",
          "settings": {
            "image_asset": "customer-review-1.jpg",
            "quote": "Maine pehli dafa order kiya tha, honestly product quality achi lagi. Abhi use kar raha hun. Or mujhy kafi farq mahsoos horha ha",
            "name": "Muhammad Usman",
            "filled_stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "image_asset": "customer-review-2.jpg",
            "quote": "Bohat se herbal products try kiye hain lekin isky bad mujhy waqai apnay andr change nazar aya ha or improvement feel hoi ha perfromance ma.",
            "name": "Ahmed Hassan",
            "filled_stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "image_asset": "customer-review-3.jpg",
            "quote": "Yaar main te pehlan soch reha si pata nahi ki hovega, par product da overall experience changa lagga. Desi cheezan di gal hi wakhri ae. Kamal hogia g",
            "name": "Gurpreet Singh",
            "filled_stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "image_asset": "customer-review-4.jpg",
            "quote": "Bhai mujhe 3 weeks ho gaye use karte hue, honestly energy mein kaafi farq feel ho raha hai. Bed time bhi pehle se better feel ho raha hai. Alhamdulillah!",
            "name": "Rizwan Ali",
            "filled_stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "image_asset": "customer-review-5.jpg",
            "quote": "Bhai pehle din se nahi lekin regular use ke baad mujhe apni daily energy aur freshness mein change feel hua hai.",
            "name": "Bilal Khan",
            "filled_stars": 4
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "product"]
  }
}
{% endschema %}
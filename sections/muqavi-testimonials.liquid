{%- style -%}
  .muqavi-testimonials-{{ section.id }} {
    padding: 56px 20px 64px;
    background: #fafafa;
  }
  .muqavi-testimonials-{{ section.id }} .testimonials__heading {
    text-align: center;
    margin: 0 auto 36px;
    max-width: 720px;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }
  .muqavi-testimonials-{{ section.id }} .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    max-width: 1240px;
    margin: 0 auto;
  }
  @media (max-width: 1100px) {
    .muqavi-testimonials-{{ section.id }} .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 749px) {
    .muqavi-testimonials-{{ section.id }} .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  @media (max-width: 480px) {
    .muqavi-testimonials-{{ section.id }} .testimonials__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #e8e8e8;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__media {
    aspect-ratio: 1;
    background: #f0f0f0;
    overflow: hidden;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__body {
    padding: 14px 14px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__stars {
    color: #f5a623;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__quote {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.45;
    color: #333;
    flex: 1;
  }
  .muqavi-testimonials-{{ section.id }} .testimonial-card__name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #1a1a1a;
  }
{%- endstyle -%}

<section class="muqavi-testimonials-{{ section.id }}">
  <h2 class="testimonials__heading">
    {{ section.settings.heading | default: 'What Our Customers Say' }}
  </h2>
  <div class="testimonials__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign review_image = block.settings.image
        if review_image == blank and block.settings.image_asset != blank
          assign review_image = block.settings.image_asset
        endif
      -%}
      <article class="testimonial-card" {{ block.shopify_attributes }}>
        <div class="testimonial-card__media">
          {%- if block.settings.image != blank -%}
            {%- assign review_alt = block.settings.name | default: 'Customer review' -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag: loading: 'lazy', alt: review_alt
            }}
          {%- elsif block.settings.image_asset != blank -%}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.name | default: 'Customer review' | escape }}"
              width="600"
              height="600"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="testimonial-card__body">
          <div class="testimonial-card__stars" aria-hidden="true">★★★★★</div>
          <p class="testimonial-card__quote">"{{ block.settings.quote }}"</p>
          {%- if block.settings.name != blank -%}
            <p class="testimonial-card__name">{{ block.settings.name }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Muqavi testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image filename (if no photo selected)",
          "info": "e.g. customer-review-1.jpg"
        },
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Muqavi testimonials",
      "settings": {
        "heading": "What Our Customers Say"
      },
      "blocks": [
        {
          "type": "review",
          "settings": {

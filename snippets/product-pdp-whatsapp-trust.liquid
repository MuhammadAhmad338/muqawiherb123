{%- liquid
  assign wa_number = settings.whatsapp_number | default: '923390091552'
  assign wa_message = 'Hi, I want to order ' | append: product.title | append: ' from ' | append: request.origin | append: product.url
  assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_message | url_encode
-%}

<div class="muqavi-pdp-trust-block">
  <a
    class="muqavi-wa-order"
    href="{{ wa_href }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="muqavi-wa-order__avatar-wrap">
      <img
        class="muqavi-wa-order__avatar"
        src="{{ 'muqavi-wa-support-avatar.png' | asset_url }}"
        alt=""
        width="88"
        height="88"
        loading="lazy"
      >
      <span class="muqavi-wa-order__wa-badge" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="16" cy="16" r="16" fill="#25D366"/>
          <path d="M16.001 7.5C11.03 7.5 7 11.53 7 16.5c0 1.76.46 3.49 1.33 5.01L7 25l3.64-.96A9.4 9.4 0 0 0 16 25.5c4.97 0 9-4.03 9-9s-4.03-9-9-9zm4.66 11.73c-.23.65-1.14 1.19-1.87 1.35-.48.1-1.11.18-3.24-.7-2.72-1.13-4.47-3.89-4.6-4.07-.13-.19-1.1-1.47-1.1-2.8 0-1.34.7-2 1-2.27.27-.28.59-.35.79-.35.2 0 .4 0 .57.01.18 0 .43-.07.67.51.23.57.8 1.96.87 2.1.07.14.11.31.02.5-.09.19-.13.31-.27.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.16.28.71 1.18 1.53 1.92 1.05.94 1.94 1.24 2.21 1.38.28.14.44.12.6-.07.16-.19.69-.8.88-1.08.19-.28.37-.23.63-.14.27.09 1.7.8 1.99.95.29.14.48.21.55.33.07.12.07.7-.16 1.35z" fill="#fff"/>
        </svg>
      </span>
    </span>
    <span class="muqavi-wa-order__content">
      <span class="muqavi-wa-order__headline">
        <strong>Muqavi Herbs™</strong>
        <span class="muqavi-wa-order__online">Online</span>
      </span>
      <span class="muqavi-wa-order__sub">👉 Order on WhatsApp</span>
    </span>
  </a>

  <div class="sc-trust-container muqavi-pdp-trust-icons">
    <div class="trst-ico">
      <img
        src="{{ 'muqavi-pdp-trust-badges.png' | asset_url }}"
        alt="Satisfaction guarantee, SSL secure, money back guarantee, Google Trusted Store"
        width="654"
        height="117"
        loading="lazy"
      >
    </div>
  </div>
</div>
{% comment %}
  Star rating display.
  Review cards: mode "discrete" + filled_stars (1–5) — one icon per star, no clip bar.
  Product bar: mode "bar" + fill_percent (0–100) — partial width fill overlay.
{% endcomment %}
{%- liquid
  assign star_mode = mode | default: 'bar'
  assign star_size = size | default: 16
  assign filled = filled_stars | default: 5 | plus: 0
  if filled > 5
    assign filled = 5
  endif
  if filled < 0
    assign filled = 0
  endif

  if star_mode == 'discrete' and filled_stars == blank
    assign star_fill = fill_percent | default: 100 | plus: 0
    if star_fill >= 100
      assign filled = 5
    elsif star_fill >= 80
      assign filled = 4
    elsif star_fill >= 60
      assign filled = 3
    elsif star_fill >= 40
      assign filled = 2
    elsif star_fill >= 20
      assign filled = 1
    else
      assign filled = 0
    endif
  endif
-%}

{%- if star_mode == 'discrete' -%}
  <div
    class="muqavi-stars muqavi-stars--discrete{% if modifier_class != blank %} {{ modifier_class }}{% endif %}"
    role="img"
    aria-label="{{ filled }} out of 5 stars"
  >
    {%- for star in (1..5) -%}
      <span class="muqavi-stars__star{% if star <= filled %} muqavi-stars__star--full{% else %} muqavi-stars__star--empty{% endif %}">
        <svg viewBox="0 0 24 24" width="{{ star_size }}" height="{{ star_size }}" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.3 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/>
        </svg>
      </span>
    {%- endfor -%}
  </div>
{%- else -%}
  {%- liquid
    assign star_fill = fill_percent | default: 100 | plus: 0
    if star_fill > 100
      assign star_fill = 100
    endif
    if star_fill < 0
      assign star_fill = 0
    endif
  -%}
  <div
    class="muqavi-stars muqavi-stars--bar{% if modifier_class != blank %} {{ modifier_class }}{% endif %}"
    style="--cs-rating-fill: {{ star_fill }}%;"
    role="img"
    aria-label="Rating {{ star_fill }} percent"
  >
    <div class="muqavi-stars__base">
      {%- for star in (1..5) -%}
        <svg viewBox="0 0 24 24" width="{{ star_size }}" height="{{ star_size }}" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.3 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/>
        </svg>
      {%- endfor -%}
    </div>
    <div class="muqavi-stars__fill">
      {%- for star in (1..5) -%}
        <svg viewBox="0 0 24 24" width="{{ star_size }}" height="{{ star_size }}" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.3 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/>
        </svg>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
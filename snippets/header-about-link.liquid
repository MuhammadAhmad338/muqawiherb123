{% comment %}
  Optional About Us link in header (desktop + drawer).
  Requires header section settings: show_about_link, about_link_label, about_page.
{% endcomment %}
{%- if section.settings.show_about_link -%}
  {%- liquid
    assign already_in_menu = false
    for link in section.settings.menu.links
      assign lt = link.title | downcase | strip
      if lt == 'about us' or lt == 'about' or link.handle == 'about-us' or link.handle == 'aboutus' or link.url contains 'aboutus' or link.url contains 'about-us'
        assign already_in_menu = true
        break
      endif
    endfor

    assign about_url = ''
    assign about_label = section.settings.about_link_label | default: 'About Us'
    assign homepage_about_anchor = routes.root_url | append: '#about-us'

    unless already_in_menu
      if section.settings.about_page != blank
        assign about_url = section.settings.about_page.url
      elsif section.settings.about_link_url != blank
        assign about_url = section.settings.about_link_url
      else
        assign about_url = '/pages/about-us'
      endif
    endunless
  -%}
  {%- if about_url != blank -%}
    {%- if drawer -%}
      <li>
        <a
          href="{{ about_url }}"
          class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
        >
          {{ about_label | escape }}
        </a>
      </li>
    {%- else -%}
      <li>
        <a
          href="{{ about_url }}"
          class="header__menu-item list-menu__item link link--text focus-inset"
        >
          <span>{{ about_label | escape }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

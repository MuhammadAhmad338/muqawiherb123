{%- liquid
  assign rating_fill = block.settings.rating_fill_percent | default: 93.6 | plus: 0
  if rating_fill > 100
    assign rating_fill = 100
  endif
-%}
<div class="cs-rating muqavi-product" {{ block.shopify_attributes }}>
  <div class="cs-rating__stars-wrap">
    {% render 'muqavi-star-rating', mode: 'bar', fill_percent: rating_fill, size: 20, modifier_class: 'cs-rating__stars' %}
    <span class="cs-rating__score">{{ block.settings.rating_score | default: '4.68/5.0' }}</span>
  </div>
</div>
